{
  "version": 2,
  "installCommand": "pnpm install",
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/webhooks/erlc",
      "dest": "/api/webhooks/erlc.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.ts"
    }
  ],
  "functions": {
    "api/webhooks/erlc.ts": {
      "maxDuration": 10,
      "bodyParsing": false
    }
  }
}
