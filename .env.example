# Copy to .env for local development. Replace placeholders locally; never commit real values.
NODE_ENV=development
LOG_LEVEL=info

# Discord application and bot (required to connect/register; never needed for dashboard compile)
DISCORD_TOKEN=replace-with-bot-token
DISCORD_APPLICATION_ID=replace-with-application-id
DISCORD_CLIENT_SECRET=replace-with-oauth-client-secret
DISCORD_DEV_GUILD_ID=replace-with-development-guild-id

# PostgreSQL. The database must be created and running before migrations or connectivity checks.
DATABASE_URL=postgresql://bcrp:bcrp-local-only@localhost:5432/bcrp?schema=public

# ER:LC API key. Optional until using the API client. Keep server-side only.
ERLC_API_KEY=replace-with-private-server-api-key

# Internal dashboard/API service communication secret; use a random local value.
API_AUTH_SECRET=replace-with-random-secret-at-least-32-characters

# Local origins (do not use NEXT_PUBLIC_ for secrets)
DASHBOARD_URL=http://localhost:3000
API_URL=http://localhost:4000
API_HOST=127.0.0.1
API_PORT=4000
BOT_HEALTH_PORT=4001

# Optional development-only feature switches
ERLC_API_BASE_URL=https://api.erlc.gg
ERLC_REQUEST_TIMEOUT_MS=10000
